# ============================================================
# Brentor.ai — Configuração de chaves de API
# Copie este arquivo para ".env" e preencha as chaves
# NUNCA compartilhe o arquivo .env (contém segredos)
# ============================================================

# ── Anthropic Claude (OBRIGATÓRIO) ──────────────────────────
# Crie sua conta em: https://console.anthropic.com
# Gere a chave em: API Keys > Create Key
ANTHROPIC_API_KEY=sk-ant-api03-SUA_CHAVE_AQUI

# ── Tavily (busca web para Analysis/Compare) ─────────────────
# Plano gratuito em: https://tavily.com
# Painel > API Keys > Generate Key
# Sem esta chave o Claude usa seu conhecimento interno (sem dados recentes)
TAVILY_API_KEY=tvly-SUA_CHAVE_AQUI

# ── Modelos Claude (opcionais — valores padrão abaixo) ───────
# Modelos mais rápidos/baratos para operações simples
MODEL_FAST=claude-3-5-haiku-20241022
# Modelo padrão para análises e relatórios
MODEL_STANDARD=claude-3-5-sonnet-20241022
# Modelo avançado para Diamond (My News 2.0, Focus 2.0, deep search)
MODEL_ADVANCED=claude-3-5-sonnet-20241022

# ── Servidor ─────────────────────────────────────────────────
PORT=4173
